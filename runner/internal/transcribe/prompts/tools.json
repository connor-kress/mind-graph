[
  {
    "type": "function",
    "function": {
      "name": "inspect_asset",
      "description": "Return real pixels of originals or previous crops. Ask for all you need together, up to 12 in a call.",
      "parameters": {
        "type": "object",
        "properties": {
          "asset_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1,
            "maxItems": 12
          }
        },
        "required": [
          "asset_ids"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "crop",
      "description": "Cut regions from pages or assets and return their pixels, with an ID for each. Ask for all you need together, up to 12 in a call. Each region names a page or an asset_id. bbox is [left,top,right,bottom] normalized 0..1000, where 50 percent is 500, relative to the full page or selected asset. Use complete related panels and labels. Can revise with another call.",
      "parameters": {
        "type": "object",
        "properties": {
          "regions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "type": "object",
              "properties": {
                "page": {
                  "type": "integer"
                },
                "asset_id": {
                  "type": "string"
                },
                "bbox": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 4,
                  "maxItems": 4
                }
              },
              "required": [
                "bbox"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "regions"
        ],
        "additionalProperties": false
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "render_pages",
      "description": "Render physical pages for a closer look, in one batch, with the coordinate grid. Crop coordinates remain relative to each full page. At most 12 pages.",
      "parameters": {
        "type": "object",
        "properties": {
          "pages": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "minItems": 1,
            "maxItems": 12
          }
        },
        "required": [
          "pages"
        ],
        "additionalProperties": false
      }
    }
  }
]
