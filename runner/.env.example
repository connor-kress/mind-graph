# Copy to .env.local, which is git-ignored. Variables set in the environment win.

# The Convex deployment's HTTP actions URL.
CONVEX_SITE_URL=https://your-deployment.convex.site
# Generate with `openssl rand -hex 32`, then set the same value on your dev deployment:
# pnpm exec convex env set --deployment dev RUNNER_SECRET <value>
# Production and each other deployment get a secret of their own.
RUNNER_SECRET=

OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-6-luna

# Development: ask every 5 seconds, and exit after 30 minutes without work.
POLL_INTERVAL=5s
IDLE_EXIT=30m
# A server: also listen for nudges from Convex (set RUNNER_URL on the deployment),
# ask every minute as a backup, and never exit.
# LISTEN=127.0.0.1:8090
# POLL_INTERVAL=60s
# IDLE_EXIT=0

# PDF_TOOL=poppler
# PROMPTS_DIR=internal/transcribe/prompts  # Read prompts from disk, to tune them without rebuilding.
# JOB_TIMEOUT=30m           # Fail a file that takes longer than this.
# MAX_PAGES=75
# RANGE_PAGES=25            # PDF pages per conversation, or slides per request.
# TURNS=16                  # Responses per conversation about a PDF's pages, including the final one.
# MAX_CROPS=40              # Crops per document.
# PARALLEL=3                # Requests at once, per document.
